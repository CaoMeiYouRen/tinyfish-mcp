{
  "name": "tinyfish-mcp",
  "version": "1.0.1",
  "description": "基于 TinyFish 免费搜索 API 的 MCP（Model Context Protocol）服务，提供网络搜索与网页内容抓取能力。支持 Stdio 和 HTTP 两种传输方式接入 Claude Desktop、Cursor、Windsurf 等 AI 客户端。",
  "author": "CaoMeiYouRen",
  "license": "MIT",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "bin": {
    "tinyfish-mcp": "dist/index.mjs",
    "tinyfish-mcp-server": "dist/server.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./server": "./dist/server.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "release": "semantic-release",
    "lint": "cross-env NODE_ENV=production eslint . --fix",
    "prebuild": "rimraf dist",
    "build": "cross-env NODE_ENV=production tsdown",
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "dev:tsup": "cross-env NODE_ENV=development tsdown --watch",
    "start": "node ./dist/index.mjs",
    "start:tsx": "cross-env NODE_ENV=production tsx src/index.ts",
    "start:benchmarks": "cross-env NODE_ENV=test BENCHMARKS_TEST=true node dist/index.mjs",
    "start:benchmarks:bun": "cross-env NODE_ENV=test BENCHMARKS_TEST=true bun dist/bun.mjs",
    "commit": "cz",
    "prepare": "husky",
    "test": "vitest run",
    "test:benchmarks": "tsx scripts/benchmarks.ts",
    "test:benchmarks:bun": "bun scripts/benchmarks.ts",
    "dev:vercel": "vercel dev",
    "deploy:vercel": "vercel",
    "dev:wrangler": "wrangler dev --env dev",
    "deploy:wrangler": "wrangler deploy",
    "dev:bun": "cross-env NODE_ENV=development bun --watch src/bun.ts",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run prebuild && npm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260517.1",
    "@types/autocannon": "^7.12.7",
    "@types/bun": "^1.3.14",
    "@types/debug": "^4.1.13",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.8.0",
    "@vercel/nft": "^1.5.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autocannon": "^8.0.0",
    "commitizen": "^4.3.1",
    "commitlint": "^21.0.1",
    "commitlint-config-cmyr": "^1.0.0",
    "cross-env": "^10.0.0",
    "cz-conventional-changelog-cmyr": "^2.0.0",
    "debug": "^4.4.3",
    "eslint": "^9.34.0",
    "eslint-config-cmyr": "^2.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "octokit": "^5.0.5",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.3",
    "semantic-release-cmyr-config": "^1.0.2",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vercel": "^54.1.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  },
  "config": {},
  "changelog": {
    "language": "zh"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "npm run lint",
      "git add"
    ]
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "search",
    "fetch",
    "tinyfish",
    "ai-agent",
    "api-service",
    "web-search",
    "llm-tools",
    "claude",
    "cursor",
    "typescript",
    "hono"
  ],
  "homepage": "https://github.com/CaoMeiYouRen/tinyfish-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaoMeiYouRen/tinyfish-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/CaoMeiYouRen/tinyfish-mcp/issues"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tiny-fish/sdk": "^0.0.8",
    "await-to-js": "^3.0.0",
    "better-bytes": "^1.2.6",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.3.5",
    "hono": "^4.12.19",
    "isomorphic-unfetch": "^4.0.2",
    "lodash-es": "^4.18.1",
    "tslib": "^2.8.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "compare-func": "^2.0.0",
      "js-yaml": "4.1.1",
      "tar": "7.5.11",
      "form-data": "^4.0.4",
      "@conventional-changelog/git-client": "^2.5.1",
      "glob": "^11.1.0",
      "undici": "^6.24.0",
      "minimatch": "^10.2.3",
      "lodash": "^4.18.0",
      "rollup": "^4.59.0",
      "esbuild": "^0.25.12",
      "path-to-regexp": "^6.3.0",
      "tmp": "^0.2.4",
      "handlebars": "^4.7.9",
      "flatted": "^3.4.2",
      "srvx": "^0.11.13",
      "@semantic-release/github": "^12.0.0",
      "@semantic-release/npm": "^13.1.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "type": "module"
}
